# Supabase project settings (Settings -> API). Required for the
# leaderboard feature; without them /api/leaderboard returns 503 and the
# leaderboard UI hides itself.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for the facilitator dashboard at /facilitator. Without
# it, /api/facilitator/login returns 503 and the dashboard stays locked.
FACILITATOR_PASSWORD=
